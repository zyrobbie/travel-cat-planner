DATABASE_URL=postgresql://catletters:replace-me@127.0.0.1:5432/catletters
APP_ORIGIN=http://127.0.0.1:3100
# Generate locally: openssl rand -hex 32. Never commit the result.
ADMIN_SECRET=
APP_MODE=INTERNAL
SAFETY_ADAPTER=synthetic-v1
# true on HTTPS deployments, false only on local HTTP.
COOKIE_SECURE=false
# E4-A is an isolated internal account slice. It does not send real email.
OTP_ADAPTER=synthetic-v1
# Generate at least 32 random bytes; never commit the value.
OTP_HASH_SECRET=
