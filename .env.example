DATABASE_URL=postgresql://catletters:replace-me@127.0.0.1:5432/catletters
APP_ORIGIN=http://127.0.0.1:3100
# Generate locally: openssl rand -hex 32. Never commit the result.
ADMIN_SECRET=
APP_MODE=INTERNAL
SAFETY_ADAPTER=synthetic-v1
# true on HTTPS deployments, false only on local HTTP.
COOKIE_SECURE=false
# E4-A is an isolated internal account slice. It does not send real email.
OTP_ADAPTER=synthetic-v1
# Generate at least 32 random bytes; never commit the value.
OTP_HASH_SECRET=

# E4-C private deletion ledger and temporary personal exports. Required before serving.
# Keep outside public/ and outside the business PostgreSQL backup/restore scope.
# Fresh setup only: migrate, then `E4_LIFECYCLE_BOOTSTRAP=true npx tsx scripts/lifecycle.ts reconcile`.
# Never replace an existing ledger with an empty directory after restoring a backup.
E4_LIFECYCLE_DIR=/absolute/private/path/catletters-lifecycle
# Independent stable secret, at least 32 characters. Never rotate implicitly on restart.
E4_LEDGER_SECRET=
# Keep false after controlled initial setup; never enable while restoring a backup.
E4_LIFECYCLE_BOOTSTRAP=false
