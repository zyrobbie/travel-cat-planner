{
  "name": "cat-letters",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 -p 3100",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 -p ${PORT:-3100}",
    "db:migrate": "tsx scripts/migrate.ts",
    "content:check": "tsx scripts/content-check.ts",
    "demo": "tsx scripts/demo.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "pages:build": "vite build --config static-app/vite.config.ts",
    "pages:preview": "vite preview --config static-app/vite.config.ts",
    "pages:test": "playwright test --config static-app/playwright.config.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "8.3.0"
  },
  "type": "module"
}
