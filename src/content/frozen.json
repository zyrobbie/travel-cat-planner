    },
    {
      "id": "TIPS-05",
      "version": "frozen-20260913-v1",
      "type": "TIP",
      "title": "小提示 5",
      "body": "不用保证它一定会被大家喜欢。也可以陪它想想：有没有一个更小、更舒服的第一步。",
      "sha256": "d837611ca0232050ffcd5fa22b54ecf2b48f09740da07d9eb3d366f9213102ed",
